# Dedicated agent keypair (NOT the treasury key, NOT a real user's wallet).
# Generate with: pnpm generate-key
AGENT_PRIVATE_KEY=
AGENT_PRIVATE_KEY_ALGO=ed25519

CASPER_RPC_URL=https://node.testnet.casper.network/rpc
CASPER_CHAIN_NAME=casper-test

# Same deployed test-USDC package the rest of the project uses.
CEP18_X402_PACKAGE=
X402_TOKEN_DECIMALS=6

# Scrybe's paywalled endpoint this agent pays to use.
SCRYBE_API_BASE=http://localhost:8080

# Only needed for the LLM-driven demo agent (src/demo-agent.ts), not the
# MCP server itself.
ANTHROPIC_API_KEY=
